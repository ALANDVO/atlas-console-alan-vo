# Atlas Console - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Atlas Console"
APP_VERSION="1.0.0"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/atlas.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/atlas

# Security (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
SECRET_KEY=dev-secret-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/atlas
OIDC_CLIENT_ID=atlas-console
OIDC_CLIENT_SECRET=atlas-console-secret
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_SCOPES=openid profile email

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Demo mode (localhost only - NEVER enable in production)
DEMO_MODE=false

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak

# LLM Providers (optional - configure via UI in future)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# MCP Servers (optional - configure via env in future)
# MCP_SERVERS=
# MCP_BURP_TRANSPORT=http
# MCP_BURP_URL=http://host.docker.internal:1337